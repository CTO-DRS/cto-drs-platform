{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/apps/clearcut",
      "destination": "/apps/lumina-studio",
      "statusCode": 308,
      "regex": "^(?!/_next)/apps/clearcut(?:/)?$"
    },
    {
      "source": "/apps/mohasabi",
      "destination": "/apps/superbiz",
      "statusCode": 308,
      "regex": "^(?!/_next)/apps/mohasabi(?:/)?$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/apps/[slug]",
      "regex": "^/api/apps/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/apps/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/apps/[slug]",
      "regex": "^/apps/([^/]+?)(?:/)?$",
