:"$undefined","xmlns":"http://www.w3.org/2000/svg","width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag post-tag-icon","aria-hidden":true,"children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],[["$","span","مصدر مفتوح",{"className":"cat-tag","children":"مصدر مفتوح"}],["$","span","GitHub",{"className":"cat-tag","children":"GitHub"}]]]}]]}],[["$","section","0",{"children":[["$","h2",null,{"children":"لماذا نفتح المصدر؟"}],[["$","p","0",{"children":"حين يكون الكود علنًا، تتحول الوعود إلى شيء قابل للفحص: أي شخص يستطيع التأكد أن التطبيق لا يفعل أكثر مما يقول، وقراءة كيف نتعامل مع البيانات والأذونات. الشفافية في الكود هي الامتداد الطبيعي لفلسفتنا في الكتالوج — معلومات صادقة يمكن التحقق منها."}],["$","p","1",{"children":"فتح المصدر يعني أيضًا تطورًا أسرع: تقارير الأخطاء تصبح دقيقة ومحددة الموقع، والمساهمات تصل من أشخاص لم نتوقعهم، وحتى الاقتراحات الصغيرة تجعل المنتج أفضل."}]]]}],["$","section","1",{"children":[["$","h2",null,{"children":"ماذا يعني هذا داخل البوابة نفسها؟"}],[["$","p","0",{"children":"التطبيقات المربوطة بمستودعات حقيقية تحمل شارة «مفتوح المصدر» في المتجر، وتعرض صفحتها بطاقة بإحصاءات حية تُجلب من واجهة GitHub وتُحدّث كل ساعة: النجوم، النسخ، لغة البرمجة، الرخصة، وتاريخ آخر تطوير. لا أرقام مخزنة يدويًا — ما تراه هو حالة المستودع الفعلية لحظة آخر تحديث."}],["$","p","1",{"children":"صفحة المشاريع تضيف طبقة ثانية: شبكة «المستودعات المفتوحة» التي تعرض أحدث المستودعات العامة لحساب CTO-DRS مرتبة بتاريخ آخر تطوير، لتتابع نبض التطوير مباشرة من البوابة دون فتح GitHub."}]]]}],["$","section","2",{"children":[["$","h2",null,{"children":"كيف تشارك؟"}],[["$","p","0",{"children":"إن وجدت خطأً أو لديك فكرة تحسين، افتح Issue في المستودع المعني وستصل البلاغة إلى الفريق مباشرة. وإن أردت المساهمة بالكود فأرسل Pull Request بعد مناقشة الفكرة في Issue — وكل مساعدة تُذكر في سجل التغييرات."}],"$L2b"]]}]],"$L2c"]}],"$L2d"]}]
2b:["$","p","1",{"children":"ولو كنت لا تكتب كودًا، فمراجعة الوثائق واقتراح صياغات أوضح أو تجربة الإصدارات على أجهزة مختلفة والتفوه عند أول خلل — كلها مساهمات تصنع فرقًا حقيقيًا."}]
