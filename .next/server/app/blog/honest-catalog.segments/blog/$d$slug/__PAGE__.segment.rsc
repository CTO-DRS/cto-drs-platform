0:{"buildId":"lpc287_UU5EVIXa1rTBB5","rsc":["$","$1","c",{"children":[["$","main",null,{"className":"container page narrow","children":[["$","$L2",null,{}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"فلسفة الكتالوج: معلومات صادقة فقط\",\"description\":\"لماذا لا تضع أرقام تحميلات ولا إصدارات غير مؤكدة في كتالوجنا؟ جولة داخل قواعد البيانات الموثوقة التي تحكم كل بطاقة في البوابة.\",\"datePublished\":\"2026-10-24\",\"inLanguage\":\"ar\",\"author\":{\"@type\":\"Organization\",\"name\":\"CTO-DRS\"},\"keywords\":\"الشفافية, الكتالوج\"}"}}],["$","div",null,{"className":"breadcrumbs-row","children":[["$","div",null,{"className":"breadcrumbs","children":[["$","$L3",null,{"href":"/","children":"الرئيسية"}]," / ",["$","$L3",null,{"href":"/blog","children":"المدونة"}]," / ",["$","span",null,{"aria-current":"page","children":"فلسفة الكتالوج: معلومات صادقة فقط"}]]}],["$","$L4",null,{"fallback":"/blog","label":"عودة للمدونة"}]]}],["$","article",null,{"className":"panel article-body","children":[["$","header",null,{"className":"article-head","children":[["$","div",null,{"className":"post-meta","children":[["$","span",null,{"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock","aria-hidden":true,"children":[["$","path","mmk7yg",{"d":"M12 6v6l4 2"}],["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],"$undefined"]}]," ","24 أكتوبر 2026"]}],["$","span",null,{"children":[5," دقائق قراءة"]}]]}],["$","h1",null,{"children":"فلسفة الكتالوج: معلومات صادقة فقط"}],["$","p",null,{"className":"article-lead","children":"لماذا لا تضع أرقام تحميلات ولا إصدارات غير مؤكدة في كتالوجنا؟ جولة داخل قواعد البيانات الموثوقة التي تحكم كل بطاقة في البوابة."}],["$","div",null,{"className":"post-tags","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag post-tag-icon","aria-hidden":true,"children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],[["$","span","الشفافية",{"className":"cat-tag","children":"الشفافية"}],["$","span","الكتالوج",{"className":"cat-tag","children":"الكتالوج"}]]]}]]}],[["$","section","0",{"children":[["$","h2",null,{"children":"المشكلة التي نراها في كل مكان"}],[["$","p","0",{"children":"معظم مواقع التطبيقات تتزاحم بأرقام تحميلات ضخمة وتقييمات ملفقة وروابط تنزيل ميتة، فيصبح المستخدم ضحية وعودٍ لا تُنفذ. جرّب يومًا أن تنزّل ملفًا من موقع لا تعرف مصدره لتكتشف أنه نسخة معدلة أو قديمة أو أسوأ من ذلك؛ هذه التجربة هي بالضبط ما أردنا أن لا يمر به مستخدمو تطبيقاتنا."}],["$","p","1",{"children":"الشفافية ليست ترفًا تسويقيًا، بل قرار هندسي يؤثر في كل تفاصيل الموقع. حين تكون كل معلومة في الكتالوج قابلة للتحقق، ينخفض الضغط على الدعم، وتعبر الثقة من موقعنا إلى التطبيقات نفسها."}]]]}],["$","section","1",{"children":[["$","h2",null,{"children":"القواعد الثلاث التي تحكم البوابة"}],[["$","p","0",{"children":"القاعدة الأولى: لا إصدارات غير مؤكدة. لا يُعرض رقم إصدار ولا تاريخ نشر في صفحة أي تطبيق إلا إذا كان معتمدًا فعليًا، ولذلك سترى عبارة «لم يُحدد بعد» في كثير من الصفحات — وهي ليست نقصًا بل صدق."}],["$","p","1",{"children":"القاعدة الثانية: لا روابط غير موثوقة. لا يُضاف رابط تنزيل أو APK إلا بعد التحقق من ملكيته وسلامة الملف، والروابط كلها عبر HTTPS. القاعدة الثالثة: المصدر الوحيد للحقيقة هو ملف الكتالوج apps.json، وكل صفحة وواجهة برمجية تقرأ منه مباشرة دون أي تعديل يدوي."}]]]}],["$","section","2",{"children":[["$","h2",null,{"children":"كيف يتدفق التحديث إلى الموقع"}],[["$","p","0",{"children":"عندما ينضج تطبيق ما — إصدار جديد، رابط تنزيل، ربط بمستودع — يُعدّل ملف الكتالوج عبر طلب سحب في GitHub، وبعد المراجعة ينشر التعديل تلقائيًا في كل مكان: البطاقات، صفحات التفاصيل، واجهة /api/apps، وخريطة الموقع. لا صفحات تُحدّث يدويًا ولا معلومات تعيش في مكانين."}],"$L5"]]}],"$L6"],"$L7"]}],"$L8"]}],["$L9"],"$La"]}],"loading":null,"isPartial":false}
5:["$","p","1",{"children":"بهذا الشكل تتحول مراجعة البيانات من عبء إداري إلى عملية هندسية قابلة للتتبع: كل تعديل له مؤلف وسبب وسجل كامل في مستودع عام يمكن لأي شخص الاطلاع عليه."}]
6:["$","section","3",{"children":[["$","h2",null,{"children":"دعوتك"}],[["$","p","0",{"children":"إن لاحظت معلومة في الكتالوج تبدو غير دقيقة، أو رابطًا لا يعمل، فبلاغك عبر صفحة الدعم أو فتح Issue في المستودع يعني لنا الكثير. نبني هذا المكان ليكون المرجع الصادق الوحيد لتطبيقات DRS، والصدق مسؤولية مشتركة بيننا وبينكم."}]]]}]
