[{"slug":"honest-catalog","title":{"ar":"فلسفة الكتالوج: معلومات صادقة فقط"},"excerpt":{"ar":"لماذا لا تضع أرقام تحميلات ولا إصدارات غير مؤكدة في كتالوجنا؟ جولة داخل قواعد البيانات الموثوقة التي تحكم كل بطاقة في البوابة."},"date":"2026-10-24","readingMinutes":5,"tags":["الشفافية","الكتالوج"],"sections":[{"heading":"المشكلة التي نراها في كل مكان","paragraphs":["معظم مواقع التطبيقات تتزاحم بأرقام تحميلات ضخمة وتقييمات ملفقة وروابط تنزيل ميتة، فيصبح المستخدم ضحية وعودٍ لا تُنفذ. جرّب يومًا أن تنزّل ملفًا من موقع لا تعرف مصدره لتكتشف أنه نسخة معدلة أو قديمة أو أسوأ من ذلك؛ هذه التجربة هي بالضبط ما أردنا أن لا يمر به مستخدمو تطبيقاتنا.","الشفافية ليست ترفًا تسويقيًا، بل قرار هندسي يؤثر في كل تفاصيل الموقع. حين تكون كل معلومة في الكتالوج قابلة للتحقق، ينخفض الضغط على الدعم، وتعبر الثقة من موقعنا إلى التطبيقات نفسها."]},{"heading":"القواعد الثلاث التي تحكم البوابة","paragraphs":["القاعدة الأولى: لا إصدارات غير مؤكدة. لا يُعرض رقم إصدار ولا تاريخ نشر في صفحة أي تطبيق إلا إذا كان معتمدًا فعليًا، ولذلك سترى عبارة «لم يُحدد بعد» في كثير من الصفحات — وهي ليست نقصًا بل صدق.","القاعدة الثانية: لا روابط غير موثوقة. لا يُضاف رابط تنزيل أو APK إلا بعد التحقق من ملكيته وسلامة الملف، والروابط كلها عبر HTTPS. القاعدة الثالثة: المصدر الوحيد للحقيقة هو ملف الكتالوج apps.json، وكل صفحة وواجهة برمجية تقرأ منه مباشرة دون أي تعديل يدوي."]},{"heading":"كيف يتدفق التحديث إلى الموقع","paragraphs":["عندما ينضج تطبيق ما — إصدار جديد، رابط تنزيل، ربط بمستودع — يُعدّل ملف الكتالوج عبر طلب سحب في GitHub، وبعد المراجعة ينشر التعديل تلقائيًا في كل مكان: البطاقات، صفحات التفاصيل، واجهة /api/apps، وخريطة الموقع. لا صفحات تُحدّث يدويًا ولا معلومات تعيش في مكانين.","بهذا الشكل تتحول مراجعة البيانات من عبء إداري إلى عملية هندسية قابلة للتتبع: كل تعديل له مؤلف وسبب وسجل كامل في مستودع عام يمكن لأي شخص الاطلاع عليه."]},{"heading":"دعوتك","paragraphs":["إن لاحظت معلومة في الكتالوج تبدو غير دقيقة، أو رابطًا لا يعمل، فبلاغك عبر صفحة الدعم أو فتح Issue في المستودع يعني لنا الكثير. نبني هذا المكان ليكون المرجع الصادق الوحيد لتطبيقات DRS، والصدق مسؤولية مشتركة بيننا وبينكم."]}]},{"slug":"open-source-on-github","title":{"ar":"تطبيقاتنا تصبح مفتوحة المصدر على GitHub"},"excerpt":{"ar":"الكود المصدري لعدد متزايد من تطبيقات DRS متاح علنًا الآن، مع إحصاءات حية داخل البوابة. إليك ما يعنيه ذلك لك كمستخدم وكمطور."},"date":"2026-10-22","readingMinutes":4,"tags":["مصدر مفتوح","GitHub"],"sections":[{"heading":"لماذا نفتح المصدر؟","paragraphs":["حين يكون الكود علنًا، تتحول الوعود إلى شيء قابل للفحص: أي شخص يستطيع التأكد أن التطبيق لا يفعل أكثر مما يقول، وقراءة كيف نتعامل مع البيانات والأذونات. الشفافية في الكود هي الامتداد الطبيعي لفلسفتنا في الكتالوج — معلومات صادقة يمكن التحقق منها.","فتح المصدر يعني أيضًا تطورًا أسرع: تقارير الأخطاء تصبح دقيقة ومحددة الموقع، والمساهمات تصل من أشخاص لم نتوقعهم، وحتى الاقتراحات الصغيرة تجعل المنتج أفضل."]},{"heading":"ماذا يعني هذا داخل البوابة نفسها؟","paragraphs":["التطبيقات المربوطة بمستودعات حقيقية تحمل شارة «مفتوح المصدر» في المتجر، وتعرض صفحتها بطاقة بإحصاءات حية تُجلب من واجهة GitHub وتُحدّث كل ساعة: النجوم، النسخ، لغة البرمجة، الرخصة، وتاريخ آخر تطوير. لا أرقام مخزنة يدويًا — ما تراه هو حالة المستودع الفعلية لحظة آخر تحديث.","صفحة المشاريع تضيف طبقة ثانية: شبكة «المستودعات المفتوحة» التي تعرض أحدث المستودعات العامة لحساب CTO-DRS مرتبة بتاريخ آخر تطوير، لتتابع نبض التطوير مباشرة من البوابة دون فتح GitHub."]},{"heading":"كيف تشارك؟","paragraphs":["إن وجدت خطأً أو لديك فكرة تحسين، افتح Issue في المستودع المعني وستصل البلاغة إلى الفريق مباشرة. وإن أردت المساهمة بالكود فأرسل Pull Request بعد مناقشة الفكرة في Issue — وكل مساعدة تُذكر في سجل التغييرات.","ولو كنت لا تكتب كودًا، فمراجعة الوثائق واقتراح صياغات أوضح أو تجربة الإصدارات على أجهزة مختلفة والتفوه عند أول خلل — كلها مساهمات تصنع فرقًا حقيقيًا."]}]},{"slug":"announcing-drs-portal","title":{"ar":"انطلاق بوابة DRS Apps & More"},"excerpt":{"ar":"كل تطبيقاتنا ومشاريعنا في مكان واحد: كتالوق حي، تفاصيل موثقة، ومستودعات مفتوحة. هذه هي البوابة الرسمية التي كنا نحتاجها منذ زمن."},"date":"2026-10-18","readingMinutes":4,"tags":["إعلانات"],"sections":[{"heading":"لماذا هذه البوابة؟","paragraphs":["عندما تتعدد التطبيقات والمشاريع، تصبح المعلومة مبعثرة: رابط في محادثة، إصدار في منشور قديم، وصف في ملف شخصي. البوابة الجديدة تجمع كل ذلك في مرجع واحد يُحدّث ذاته: كتالوق للتطبيقات، صفحة للمشاريع وحالتها، ومركز توثيق ودعم.","بنيناها لتكون بسيطة وسريعة وخفيفة — بلا قاعدة بيانات ولا حسابات ولا تعقيد. الموقع يقرأ ملف كتالوج واحد ويعرضه بصفحات مُحسّنة لمحركات البحث، مع واجهة برمجية عامة تتيح لأي شخص استهلاك البيانات في تطبيقه."]},{"heading":"ماذا تجد هنا؟","paragraphs":["في صفحة التطبيقات تجد البطاقات بحالتها الحقيقية: ما هو متاح، وما قيد التطوير، مع بحث عربي فوري يتجاهل التشكيل ويوحّد الحروف، وفلاتر للفئات والحالات تُزامَن مع رابط الصفحة لتشاركها بسهولة. كل تطبيق له صفحة تفاصيل كاملة تُظهر الوصف والمميزات والمتطلبات وروابط التنزيل المؤكدة فقط.","أما عشاق التفاصيل التقنية فسيجدون في صفحة المشاريع إحصاءات المستودعات المفتوحة الحية، وفي صفحة التوثيق كيفية استخدام الواجهة البرمجية وقواعد المساهمة في الكتالوج."]},{"heading":"وما القادم؟","paragraphs":["هذه البداية فقط. في الطريق: إصدارات جديدة من التطبيقات قيد التطوير، ربط المزيد من المستودعات، ومقالات تشرح كواليس بناء المنتجات. تابع حساب GitHub أو اشترك في موجز RSS للمدونة لتصلك التحديثات أولًا بأول."]}]}]