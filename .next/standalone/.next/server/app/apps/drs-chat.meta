{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/apps/layout,_N_T_/apps/[slug]/layout,_N_T_/apps/[slug]/page,_N_T_/apps/drs-chat"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/apps/$d$slug/__PAGE__",
    "/apps/$d$slug",
    "/apps",
    "/_index",
    "/_head"
  ]
}