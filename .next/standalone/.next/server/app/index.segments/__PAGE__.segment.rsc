9:["$","$L10",null,{"children":["$","section",null,{"className":"container","id":"apps","children":["$","$L12",null,{"apps":[{"slug":"masar-al-lugha","name":{"ar":"مسار اللغة","en":"Masar Al-Lugha"},"category":"education","status":"released","summary":{"ar":"تطبيق مفتوح المصدر لتعلّم الإنجليزية والأردية ببطاقات FSRS الذكية ودروس متدرجة وعناصر لعبة — أول إصدار رسمي v4.8.0 متاح الآن.","en":"An open language-learning app: learn English & Urdu with smart FSRS flashcards, leveled lessons and gamification — first official release v4.8.0 is out."},"description":{"ar":"منصة تعلّم لغات مفتوحة المصدر مبنية بتقنية Flutter، تجعل تعلّم الإنجليزية والأردية تجربة ممتعة: بطاقات مراجعة ذكية تعتمد خوارزمية FSRS لجدولة التكرار المتباعد، دروس مقسّمة إلى مستويات متدرجة، ونظام تحفيز على طريقة الألعاب يحفظ اندفاعك في التعلّم. صدر أول إصدار رسمي v4.8.0 وتليه إصدارات متتابعة بوتيرة نشطة — حمّل APK من GitHub وابدأ رحلتك.","en":"An open-source language learning platform built with Flutter. Learn English & Urdu the fun way: smart FSRS-based spaced-repetition flashcards, leveled lessons, and gamified motivation. The first official release v4.8.0 is out with active follow-up releases — grab the APK from GitHub and start your journey."},"platforms":["Android"],"version":"4.8.0","releaseDate":"2026-10-24","icon":"languages","tint":"lang","pricing":"free","features":[{"ar":"بطاقات مراجعة ذكية بنظام FSRS للتكرار المتباعد","en":"Smart FSRS-based spaced-repetition flashcards"},{"ar":"دروس مقسمة إلى مستويات متدرجة","en":"Leveled, progressive lessons"},{"ar":"الإنجليزية والأردية في تطبيق واحد","en":"English & Urdu in a single app"},{"ar":"نظام تحفيز وألعاب يحفز على الاستمرارية","en":"Gamified motivation to keep streaks going"}],"requirements":[],"downloads":[{"label":{"ar":"تحميل APK (v4.8.0)","en":"Download APK (v4.8.0)"},"url":"https://github.com/CTO-DRS/masar-al-lugha/releases/download/v4.8.0/masar-al-lugha-v4.8.0.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/masar-al-lugha/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/masar-al-lugha","website":null,"privacyPolicy":null,"changelog":[{"version":"4.8.0","date":"2026-10-24","notes":[{"ar":"أول إصدار رسمي متاح للتحميل بصيغة APK","en":"First official release available as APK download"},{"ar":"بطاقات FSRS ودروس متدرجة ونظام تحفيز بالألعاب","en":"FSRS flashcards, leveled lessons and gamified motivation"}]}],"verified":true,"appIcon":"/apps-icons/masar-al-lugha.png"},{"slug":"drs-nexus","name":{"ar":"DRS Nexus","en":"DRS Nexus"},"category":"tools","status":"released","summary":{"ar":"صندوق أدوات مطوّرين أندرويد أصلي يعمل دون اتصال: عشرون أداة حقيقية بواجهة ثنائية اللغة عربي/إنجليزي.","en":"Native Android offline developer toolkit: 20 real utilities in a bilingual Arabic/English interface."},"description":{"ar":"مجموعة أدوات أندرويد أصلية مبنية بـ Kotlin وJetpack Compose مع قاعدة بيانات Room، تجمع عشرين أداة مطوّرين حقيقية تعمل بالكامل على الجهاز دون أي اتصال شبكي: منسق JSON مع مواضع الأخطاء بالسطر والعمود، ترميز Base64 متوافق مع الرابط الآمن، وغيرها. واجهة ثنائية اللغة عربي/إنجليزي بدعم RTL كامل، بلا حسابات ولا تتبع — الأذونات المطلوبة هي الإنترنت وحالة الشبكة فقط.","en":"A native Android toolkit (Kotlin + Jetpack Compose + Room) bundling 20 real, fully-offline developer utilities: a JSON formatter with line-column error positions, URL-safe Base64, and more. Bilingual Arabic/English interface with full RTL. No accounts, no tracking — only INTERNET and network-state permissions are requested."},"platforms":["Android"],"version":"5.4.0","releaseDate":"2026-10-20","icon":"letter-N","tint":"nexus","pricing":"free","features":[{"ar":"20 أداة تعمل 100% دون إنترنت","en":"20 tools that work 100% offline"},{"ar":"منسق JSON مع مواضع أخطاء بالسطر والعمود","en":"JSON formatter with line-column error positions"},{"ar":"ترميز وفك Base64 متوافق مع URL-safe","en":"URL-safe Base64 encode/decode"},{"ar":"شاشة إحصاءات استخدام مبنية على تجميعات سجل Room","en":"Usage insights computed from Room history"},{"ar":"واجهة عربي/إنجليزي بدعم RTL كامل","en":"Bilingual AR/EN with full RTL"}],"requirements":[],"downloads":[{"label":{"ar":"تحميل APK (v5.4.0)","en":"Download APK (v5.4.0)"},"url":"https://github.com/CTO-DRS/drs-nexus/releases/download/v5.4.0/DRS-Nexus-v5.4.0-release-signed.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/drs-nexus/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/drs-nexus","website":null,"privacyPolicy":null,"changelog":[{"version":"5.4.0","date":"2026-10-20","notes":[{"ar":"شاشة إحصاءات الاستخدام: تجميعات حقيقية من سجل Room عبر وحدة UsageStats نقية","en":"Usage insights screen: real aggregates from Room history via a pure UsageStats module"},{"ar":"ثلاث ميزات جديدة في هذه الجولة — كلها دون اتصال وأصلية","en":"Three new features this round — all offline, all native"}]},{"version":"5.3.0","date":"2026-10-19","notes":[{"ar":"عرض شبكي للأدوات (عمودان) مع حفظ الاختيار في DataStore","en":"Grid view for tools (two columns) with the choice persisted in DataStore"},{"ar":"اختصارات لوحة مفاتيح جديدة","en":"New keyboard shortcuts"}]}],"verified":true,"appIcon":"/apps-icons/drs-nexus.png"},{"slug":"drs-chat","name":{"ar":"DRS Chat","en":"DRS Chat"},"category":"communication","status":"in-development","summary":{"ar":"مراسل مشفّر يعمل بمنطق «دون اتصال أولًا» على أندرويد — المرحلة الأولى قيد التطوير النشط.","en":"Offline-first encrypted messenger for Android — Phase 1 under active development."},"description":{"ar":"مشروع مراسلة أندرويد أصلي بلغة Kotlin بفلسفة «دون اتصال أولًا» وتشفير للرسائل، في مراحله الأولى من التطوير. يُتابع التقدم عبر المستودع على GitHub، وستظهر روابط التنزيل في هذه الصفحة مباشرة بعد نشر أول إصدار رسمي — بلا روابط وهمية.","en":"A native Android messenger written in Kotlin, built offline-first with encrypted messaging, in its earliest development phase. Progress is tracked in the GitHub repository; download links will appear on this page right after the first official release — no placeholder links."},"platforms":["Android"],"version":null,"releaseDate":null,"icon":"messages-square","tint":"chat","pricing":"free","features":[],"requirements":[],"downloads":[],"repository":"https://github.com/CTO-DRS/drs-chat","website":null,"privacyPolicy":null,"changelog":[],"verified":true,"appIcon":null},{"slug":"lumina-studio","name":{"ar":"لومينا ستوديو","en":"Lumina Studio"},"category":"media","status":"released","summary":{"ar":"محرر فيديو سينمائي بدقة 4K لأندرويد: خطوط أنابيب تصدير حقيقية بـ MediaCodec وOpenGL وتحليل بكسل وصوت PCM.","en":"Cinematic 4K video editor for Android with real MediaCodec/OpenGL export pipelines, pixel-level analysis and PCM audio."},"description":{"ar":"محرر فيديو سينمائي 4K لأندرويد مبني بـ Kotlin وJetpack Compose على مبدأ واحد: كل خط أنابيب حقيقي — لا أشرطة تقدم محاكاة ولا بيانات تجريبية ولا خوارزميات وهمية؛ ما يعرضه التطبيق هو ما قِسه العتاد والخوارزميات فعلًا. يشمل تصدير MediaCodec/OpenGL، تحليل صور على مستوى البكسل، رسمًا صوتيًا PCM متعدد المسارات، وتوليف مؤثرات صوتية إجرائية — مع 32 اختبار وحدة ناجحًا وبناء CI موثق وترخيص MIT.","en":"A cinematic 4K video editor for Android (Kotlin + Jetpack Compose) built on one principle: every pipeline is real — no simulated progress bars, no seeded demo data, no placeholder algorithms; what the UI reports is what the hardware actually measured. Includes MediaCodec/OpenGL export, pixel-level frame analysis, multi-track PCM audio graph, and procedural SFX synthesis — 32/32 unit tests passing, verified CI builds, MIT licensed."},"platforms":["Android"],"version":"1.1.0","releaseDate":"2026-09-23","icon":"clapperboard","tint":"video","pricing":"free","features":[{"ar":"تصدير فيديو 4K عبر خط أنابيب MediaCodec/OpenGL","en":"4K video export via a MediaCodec/OpenGL pipeline"},{"ar":"تحليل إطارات على مستوى البكسل","en":"Pixel-level frame analysis"},{"ar":"رسم صوتي PCM متعدد المسارات","en":"Multi-track PCM audio graph"},{"ar":"توليف مؤثرات صوتية SFX إجرائية","en":"Procedural SFX synthesis"},{"ar":"32 اختبار وحدة ناجحًا وبناء CI موثق","en":"32/32 unit tests passing with verified CI builds"}],"requirements":["Android 7.0+ (minSdk 24)"],"downloads":[{"label":{"ar":"تحميل APK (v1.1.0)","en":"Download APK (v1.1.0)"},"url":"https://github.com/CTO-DRS/Lumina-Studio/releases/download/v1.1.0/LuminaStudio-v1.1.0-debug.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/Lumina-Studio/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/Lumina-Studio","website":null,"privacyPolicy":null,"changelog":[{"version":"1.1.0","date":"2026-09-23","notes":[{"ar":"إعادة تنظيم كامل للمشروع: فصل محرك engine إلى خمس حزم مجالات (تحليل، صوت، ألوان، تصدير، وسائط)","en":"Full project reorganization: engine split into 5 domain packages (analysis, audio, color, export, media)"}]},{"version":"1.0.0","date":"2026-09-23","notes":[{"ar":"أول بناء موثق في بيئة نظيفة: JDK 21 وGradle 9.3.1 وAndroid SDK 36.1","en":"First release built and verified in a clean environment (JDK 21, Gradle 9.3.1, Android SDK 36.1)"},{"ar":"32/32 اختبار وحدة ناجحًا بما فيها اختبارات Robolectric للرسوميات","en":"32/32 unit tests pass including Robolectric NATIVE-graphics tests"}]}],"verified":true,"appIcon":null},{"slug":"drs-keyboard","name":{"ar":"DRS Smart Keyboard","en":"DRS Smart Keyboard"},"category":"tools","status":"released","summary":{"ar":"لوحة مفاتيح أندرويد عربية أولًا: ذكاء على الجهاز، خصوصية مثبتة، ونظام حزم سمات موقّع تشفيريًا.","en":"Arabic-first Android keyboard: on-device intelligence, proven privacy, and cryptographically signed theme packages."},"description":{"ar":"لوحة مفاتيح IME أندرويد عربية أصيلة بالكامل من تطوير DRS — عربية أولًا، خاصة بالكامل، وقابلة للتخصيص بعمق: اقتراحات ذكية تعمل على الجهاز دون أي سحابة، نظام حزم سمات وامتدادات بامتداد .flex موقّع تشفيريًا للتثبيت الآمن، ومطبخ إيموجي (Emoji Kitchen) للتركيب الإبداعي بين الرموز. لوحة مفاتيح تشعر أنها صُممت للعربية من البداية لا مترجمة إليها.","en":"A fully native Arabic Android IME built by DRS — Arabic-first, completely private, deeply customizable: on-device suggestions with no cloud, cryptographically signed .flex theme and extension packages for safe installs, and Emoji Kitchen for creative emoji combining. A keyboard designed for Arabic from day one, not translated into it."},"platforms":["Android"],"version":"1.4.2","releaseDate":"2026-10-22","icon":"keyboard","tint":"keyboard","pricing":"free","features":[{"ar":"عربية أولًا مع دعم كامل ثنائي اللغة","en":"Arabic-first with full bilingual support"},{"ar":"اقتراحات ذكية تعمل على الجهاز دون سحابة","en":"On-device suggestions with no cloud"},{"ar":"حزم سمات وامتدادات .flex موقّعة تشفيريًا","en":"Cryptographically signed .flex theme packages"},{"ar":"مطبخ الإيموجي Emoji Kitchen","en":"Emoji Kitchen support"},{"ar":"خصوصية مثبتة بلا تتبع","en":"Proven privacy with zero tracking"}],"requirements":[],"downloads":[{"label":{"ar":"تحميل APK (v1.4.2)","en":"Download APK (v1.4.2)"},"url":"https://github.com/CTO-DRS/DRS-Smart-Keyboard/releases/download/v1.4.2/DRS-Smart-Keyboard-v1.4.2.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/DRS-Smart-Keyboard/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/DRS-Smart-Keyboard","website":null,"privacyPolicy":null,"changelog":[{"version":"1.4.2","date":"2026-10-22","notes":[{"ar":"مطبخ الإيموجي والحزم المستلمة — الإصدار السابع","en":"Emoji Kitchen & received packages — seventh release"}]},{"version":"1.4.1","date":"2026-10-21","notes":[{"ar":"«الوجه الأمني» — إصدار الحماية السادس","en":"The Security Face — sixth release"}]}],"verified":true,"appIcon":null},{"slug":"superbiz","name":{"ar":"سوبر بيز","en":"SuperBiz"},"category":"business","status":"released","summary":{"ar":"نظام إدارة أعمال متكامل لأندرويد يعمل دون اتصال 100%: فواتير ومخزون وتقارير بأكثر من 1400 اختبار.","en":"A fully offline Android business management system: invoicing, inventory and reports backed by 1,400+ tests."},"description":{"ar":"نظام إدارة الأعمال المتكامل لأندرويد (Kotlin + Jetpack Compose + Material 3) يعمل دون اتصال بالكامل: فواتير، مخزون، عملاء وتقارير. مبني على أساس هندسي صارم: أكثر من 1400 اختبار انحدار أخضر، قفل حيوي (Biometric)، ومصفوفة صلاحيات RBAC موثقة — مع دورات إصلاح موثقة من أول بلاغ حتى الاختبار. واجهة عربية كاملة مصممة لأصحاب الأعمال الصغيرة والمتوسطة.","en":"A complete Android business system (Kotlin + Jetpack Compose + Material 3) that works 100% offline: invoices, inventory, customers and reports. Built on a strict engineering foundation: 1,400+ passing regression tests, biometric lock, and a documented RBAC permission matrix — with owner-reported fixes documented end-to-end. A full Arabic UI designed for small and medium businesses."},"platforms":["Android"],"version":"3.5.2","releaseDate":"2026-10-20","icon":"calculator","tint":"finance","pricing":"free","features":[{"ar":"فواتير ومخزون يعمل دون اتصال بالكامل","en":"Fully offline invoicing and inventory"},{"ar":"قفل حيوي ومصفوفة صلاحيات RBAC موثقة","en":"Biometric lock and a documented RBAC matrix"},{"ar":"واجهة Material 3 عربية كاملة","en":"Complete Arabic Material 3 interface"},{"ar":"أكثر من 1400 اختبار انحدار أخضر","en":"1,400+ passing regression tests"},{"ar":"تقارير وإدارة عملاء","en":"Reports and customer management"}],"requirements":["Android 7.0+ (minSdk 24)"],"downloads":[{"label":{"ar":"تحميل APK (v3.5.2)","en":"Download APK (v3.5.2)"},"url":"https://github.com/CTO-DRS/SuperBiz/releases/download/v3.5.2/SuperBiz-v3.5.2-debug.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/SuperBiz/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/SuperBiz","website":null,"privacyPolicy":null,"changelog":[{"version":"3.5.2","date":"2026-10-20","notes":[{"ar":"إصلاح سطر الفاتورة النصي الحر (الكمية 22) المبلغ عنه من المالك — موثق من أول بلاغ حتى الاختبار","en":"Owner-reported free-text invoice line bug (qty=22) fixed end-to-end with RED-first evidence"}]},{"version":"3.5.1","date":"2026-10-20","notes":[{"ar":"تنفيذ حكمي المراجعة الهندسية وإغلاق ثغرة قفل القياس الحيوي","en":"Both audit rulings executed and the biometric lockout gap closed"}]}],"verified":true,"appIcon":"/apps-icons/superbiz.png"},{"slug":"violet-chat","name":{"ar":"فايلويت شات","en":"Violet Chat"},"category":"communication","status":"released","summary":{"ar":"تطبيق مراسلة أندرويد بهوية بنفسجية داكنة فاخرة وتشفير طرف-لطرف، مبني بـ Flutter وFirebase.","en":"An Android messenger with a rich dark-violet identity and end-to-end encryption, built with Flutter & Firebase."},"description":{"ar":"تطبيق مراسلة أندرويد بهوية بنفسجية داكنة فاخرة، مشفّر طرف-لطرف، مبني بـ Flutter مع Firebase Authentication وCloud Firestore وSupabase لنقل المراسلة. هوية الحزمة com.drs.violetchat مسجلة رسميًا في Firebase، وهو التطوير الحديث لتطبيق DRS NEXORA السابق مع الحفاظ على جميع الميزات القائمة — وتُنشر الإصدارات بوتيرة نشطة: ميزات الوسائط الذكية وشاشة الموقع وجهات الاتصال في أحدث إصدار.","en":"An Android messenger with a luxurious dark-violet identity and end-to-end encryption, built with Flutter + Firebase Authentication + Cloud Firestore + Supabase messaging. The package identity com.drs.violetchat is officially registered with Firebase; it is the modern evolution of the previous DRS NEXORA app with all features kept — releasing actively, with smart-media features and the contacts/site screen in the latest version."},"platforms":["Android"],"version":"0.1.12","releaseDate":"2026-10-24","icon":"letter-V","tint":"violet","pricing":"free","features":[{"ar":"تشفير طرف-لطرف للرسائل","en":"End-to-end encrypted messaging"},{"ar":"مصادقة Firebase ومزامنة Cloud Firestore","en":"Firebase authentication with Cloud Firestore sync"},{"ar":"نقل الرسائل عبر Supabase","en":"Messaging transport via Supabase"},{"ar":"هوية بنفسجية داكنة فاخرة بواجهة Flutter","en":"Luxurious dark-violet Flutter interface"},{"ar":"إصدارات لكل المعماريات: arm64 وarmv7 وuniversal","en":"Builds for every ABI: arm64, armv7 and universal"}],"requirements":[],"downloads":[{"label":{"ar":"تحميل APK (v0.1.12 — Universal)","en":"Download APK (v0.1.12 — Universal)"},"url":"https://github.com/CTO-DRS/VioletChat/releases/download/v0.1.12/app-universal-release.apk","kind":"apk"},{"label":{"ar":"تحميل APK لمعمارية arm64","en":"Download APK (arm64-v8a)"},"url":"https://github.com/CTO-DRS/VioletChat/releases/download/v0.1.12/app-arm64-v8a-release.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/VioletChat/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/VioletChat","website":null,"privacyPolicy":null,"changelog":[{"version":"0.1.12","date":"2026-10-24","notes":[{"ar":"«الموقع وجهات الاتصال»: ثلاث ميزات جديدة تحت مظلة الوسائط الذكية","en":"Site & contacts screen: three new features under the smart-media umbrella"}]},{"version":"0.1.11","date":"2026-10-23","notes":[{"ar":"تحسينات الاستطلاعات والحالات بطلب مباشر من المالك","en":"Polls and status improvements, owner-requested"}]}],"verified":true,"appIcon":"/apps-icons/violet-chat.png"},{"slug":"securenet-vpn","name":{"ar":"SecureNet VPN","en":"SecureNet VPN"},"category":"tools","status":"released","summary":{"ar":"حل خصوصية مؤسسي لأندرويد: أنفاق WireGuard حقيقية وفحص أمان للجهاز وتحسين الشبكة في تطبيق واحد.","en":"Enterprise-grade privacy for Android: real WireGuard tunneling, on-device security auditing and network optimization."},"description":{"ar":"حماية خصوصية بمستوى مؤسسي لأندرويد في تطبيق واحد: أنفاق WireGuard عبر النواة مفتوحة المصدر wireguard-go فوق JNI (libwgcore.so) مجمعة لمعماريات arm64 وarmeabi-v7a وx86_64، مدقق أمان يعمل على الجهاز لكشف البرمجيات الخبيثة، ومحسّن أداء شبكة — بمعمارية MVVM + Clean Architecture بلغة Kotlin 2.0 وC++17 (NDK).","en":"Enterprise-grade Android privacy in one app: WireGuard tunnels via the open-source wireguard-go userspace backend over JNI (libwgcore.so) built for arm64, armeabi-v7a and x86_64, on-device malware auditing, and network performance optimization — MVVM + Clean Architecture in Kotlin 2.0 and C++17 (NDK)."},"platforms":["Android"],"version":"1.0.0","releaseDate":"2026-10-24","icon":"letter-S","tint":"shield","pricing":"free","features":[{"ar":"أنفاق WireGuard حقيقية عبر wireguard-go/JNI","en":"Real WireGuard tunneling via wireguard-go/JNI"},{"ar":"فحص برمجيات خبيثة يعمل على الجهاز","en":"On-device malware auditing"},{"ar":"تحسين أداء الشبكة","en":"Network performance optimization"},{"ar":"معمارية MVVM + Clean Architecture","en":"MVVM + Clean Architecture"},{"ar":"Kotlin 2.0 مع C++17 (NDK) وGo","en":"Kotlin 2.0 with C++17 (NDK) and Go"}],"requirements":["Android 11+ (API 30)"],"downloads":[{"label":{"ar":"تحميل APK (v1.0.0)","en":"Download APK (v1.0.0)"},"url":"https://github.com/CTO-DRS/SecureNetVPN/releases/download/v1.0.0/SecureNetVPN-debug-v1.0.0.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/SecureNetVPN/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/SecureNetVPN","website":null,"privacyPolicy":null,"changelog":[{"version":"1.0.0","date":"2026-10-24","notes":[{"ar":"البناء الإنتاجي الكامل الأول: مستوى بيانات WireGuard-Go حقيقي لثلاث معماريات مع النواة الأصلية libsecurenet.so","en":"First full production build: real WireGuard-Go data plane for three ABIs plus the native libsecurenet.so core"}]}],"verified":true,"appIcon":null},{"slug":"novafiles","name":{"ar":"NovaFiles","en":"NovaFiles"},"category":"tools","status":"released","summary":{"ar":"مدير ملفات أندرويد مفتوح المصدر بواجهة عربية أنيقة: خزنة مشفرة وسحابة موحدة ومشاركة متقدمة.","en":"An open-source Android file manager with an elegant Arabic UI: encrypted vault, unified cloud and advanced sharing."},"description":{"ar":"مدير ملفات أندرويد مفتوح المصدر مبني من الصفر بـ Kotlin وJetpack Compose وMaterial 3 — منافس عصري وطموح لـ MiXplorer المغلق المصدر: خزنة ملفات مشفرة، سحابة موحدة متعددة الخدمات، مشاركة متقدمة، وواجهة عربية أنيقة بلمسة كوبرتينو حديثة. تطوير يومي نشط بإصدارات متلاحقة تُنشر على GitHub.","en":"An open-source Android file manager built from scratch with Kotlin + Jetpack Compose + Material 3 — a modern challenger to the closed-source MiXplorer: an encrypted file vault, unified multi-service cloud, advanced sharing, and a polished Arabic UI with a modern Cupertino touch. Under active daily development with consecutive GitHub releases."},"platforms":["Android"],"version":"0.40.0","releaseDate":"2026-10-24","icon":"folder-open","tint":"folder","pricing":"free","features":[{"ar":"خزنة ملفات مشفرة","en":"Encrypted file vault"},{"ar":"سحابة موحدة متعددة الخدمات","en":"Unified multi-service cloud"},{"ar":"مشاركة متقدمة بين الأجهزة","en":"Advanced sharing"},{"ar":"واجهة عربية Material 3 بلمسة كوبرتينو","en":"Arabic Material 3 UI with a Cupertino touch"},{"ar":"مفتوح المصدر بالكامل","en":"Fully open source"}],"requirements":["Android 8.0+ (minSdk 26)"],"downloads":[{"label":{"ar":"تحميل APK (v0.40.0)","en":"Download APK (v0.40.0)"},"url":"https://github.com/CTO-DRS/NovaFiles/releases/download/v0.40.0/NovaFiles_v0.40.0_iOS_debug.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/NovaFiles/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/NovaFiles","website":null,"privacyPolicy":null,"changelog":[{"version":"0.40.0","date":"2026-10-24","notes":[{"ar":"تحديث على مسار التطوير اليومي النشط — الفرق الكامل موثق في صفحة الإصدار","en":"Update on the active daily-development track — full diff in the release page"}]},{"version":"0.39.0","date":"2026-10-24","notes":[{"ar":"استمرار سلسلة التحديثات المتلاحقة — التفاصيل في المقارنة الرسمية بين الإصدارين","en":"Continuing the consecutive update series — details in the official compare view"}]}],"verified":true,"appIcon":null},{"slug":"nexuslink","name":{"ar":"NexusLink","en":"NexusLink"},"category":"tools","status":"released","summary":{"ar":"منصة ربط هاتفك بالكمبيوتر عبر الشبكة المحلية: بث شاشة وكاميرا وصوت وتحكم عن بعد ونقل ملفات — بلا سحابة.","en":"Connect your phone to your PC over LAN: screen/camera/audio streaming, remote control and file transfer — no cloud."},"description":{"ar":"منصة واحدة تربط هاتفك بجهاز الكمبيوتر وكل شيء محلي عبر شبكتك — بلا سحابة وبلا حسابات: خادم سطح مكتب Next.js للويندوز وماك، مع وكيل أندرويد Flutter يوفر بث الشاشة والكاميرا والصوت، وتحكمًا عن بُعد، ونقل ملفات، وحزمة أدوات أمان. الإصدار 3.0 (المرحلة M4 «الثقل المؤسسي») يضيف النشر المؤسسي وأدلة شهادات الثقة ووضع OEM بخصوصية افتراضية.","en":"One platform connecting your phone to your computer — everything local on your network, no cloud, no accounts: a Next.js desktop server for Windows/macOS with a Flutter Android agent delivering screen/camera/audio streaming, remote control, file transfer, and a security suite. v3.0 (milestone M4) adds enterprise deployment, trust-certificate stores, and an OEM mode with privacy by default."},"platforms":["Android","Windows","macOS"],"version":"3.0.0","releaseDate":"2026-10-22","icon":"monitor-smartphone","tint":"link","pricing":"free","features":[{"ar":"بث الشاشة والكاميرا والصوت على الشبكة المحلية","en":"Screen, camera and audio streaming over LAN"},{"ar":"تحكم عن بعد بالهاتف من الكمبيوتر","en":"Remote control of the phone from the PC"},{"ar":"نقل ملفات سريع دون سحابة","en":"Fast cloudless file transfer"},{"ar":"خادم ويندوز/ماك + وكيل أندرويد Flutter","en":"Windows/macOS server + Flutter Android agent"},{"ar":"وضع OEM وخصوصية افتراضية","en":"OEM mode with privacy by default"}],"requirements":["Windows 10/11 64-bit أو macOS 12+ لخادم سطح المكتب","أندرويد لوكيل الهاتف"],"downloads":[{"label":{"ar":"تحميل APK للأندرويد (v3.0.0)","en":"Download Android APK (v3.0.0)"},"url":"https://github.com/CTO-DRS/NexusLink/releases/download/v3.0.0/NexusLink-3.0.0-release.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/NexusLink/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/NexusLink","website":null,"privacyPolicy":null,"changelog":[{"version":"3.0.0","date":"2026-10-22","notes":[{"ar":"إصدار M4 «الثقل المؤسسي»: النشر المؤسسي وأدلة شهادات الثقة ووضع OEM «خصوصية افتراضية»","en":"Milestone M4: enterprise deployment, trust-certificate stores and OEM privacy-by-default mode"}]}],"verified":true,"appIcon":"/apps-icons/nexuslink.png"},{"slug":"drs-ai","name":{"ar":"DRS AI","en":"DRS AI"},"category":"tools","status":"released","summary":{"ar":"مساعد ذكاء اصطناعي خاص يعمل بالكامل على هاتفك: نماذج محلية وصوت وأدوات — بلا حساب ولا سحابة ولا إنترنت.","en":"A private AI assistant running entirely on your phone: local models, voice and tools — no account, cloud or internet."},"description":{"ar":"مساعد ذكاء اصطناعي يعمل بالكامل على هاتفك: تحدث مع نماذج اللغة، امنحها صوتًا، ودعها تستخدم أدوات — كل ذلك على الجهاز. معظم تطبيقات الذكاء الاصطناعي هي نافذة رقيقة على خوادم الآخرين؛ DRS AI يجعل النموذج ملكك: بلا حساب، بلا سحابة، وبلا حاجة للإنترنت. يُوزع كملف APK موقّع بنفس شهادة الإصدار يثبّت مباشرة فوق النسخ السابقة.","en":"A private AI assistant that runs entirely on your phone: chat with language models, give them a voice, and let them use tools — all on-device. Most AI apps are a thin window onto someone else's server; DRS AI makes the model yours: no account, no cloud, no internet required. Distributed as a signed APK that installs directly over previous versions."},"platforms":["Android"],"version":"1.41.1","releaseDate":"2026-10-22","icon":"sparkles","tint":"ai","pricing":"free","features":[{"ar":"نماذج لغوية تعمل محليًا على الجهاز","en":"Language models running fully on-device"},{"ar":"صوت للمساعد واستخدام الأدوات","en":"Assistant voice and tool use"},{"ar":"بلا حساب أو سحابة أو إنترنت","en":"No account, no cloud, no internet"},{"ar":"تثبيت مباشر فوق الإصدارات السابقة بنفس الشهادة","en":"Direct over-install with the same signing certificate"}],"requirements":["Android 7.0+","معالج 64 بت (ARM64) — جميع الهواتف الحديثة","مساحة تخزين فارغة لا تقل عن 400MB"],"downloads":[{"label":{"ar":"تحميل APK (v1.41.1)","en":"Download APK (v1.41.1)"},"url":"https://github.com/CTO-DRS/DRS-AI-Phone/releases/download/v1.41.1/DRS-AI-v1.41.1.apk","kind":"apk"},{"label":{"ar":"كل الإصدارات على GitHub","en":"All releases on GitHub"},"url":"https://github.com/CTO-DRS/DRS-AI-Phone/releases","kind":"release"}],"repository":"https://github.com/CTO-DRS/DRS-AI-Phone","website":null,"privacyPolicy":null,"changelog":[{"version":"1.41.1","date":"2026-10-22","notes":[{"ar":"APK موقّع بنفس شهادة الإصدار — يثبّت مباشرة فوق النسخ السابقة","en":"APK signed with the release certificate — installs directly over previous versions"},{"ar":"إرشادات التحقق من اكتمال التنزيل قبل التثبيت","en":"Download-integrity verification guidance before install"}]}],"verified":true,"appIcon":"/apps-icons/drs-ai.png"}],"statsMap":{}}]}]}]
